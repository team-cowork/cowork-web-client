server {
  listen 80;
  server_name ${SERVER_NAME};

  client_max_body_size 10m;

  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location = /config.js {
    default_type application/javascript;
    add_header Cache-Control "no-store";
    return 200 "window.__MF_REMOTES__ = { cowork_chat: '${CHAT_REMOTE_URL}', cowork_issue: '${ISSUE_REMOTE_URL}', cowork_profile: '${PROFILE_REMOTE_URL}' }; window.__AUTH_CONFIG__ = { clientId: '${DATAGSM_CLIENT_ID}', authApiBaseUrl: '${AUTH_API_BASE_URL}' };";
  }

  location /_mf/chat/    { proxy_pass http://chat:80; }
  location /_mf/issue/   { proxy_pass http://issue:80; }
  location /_mf/profile/ { proxy_pass http://profile:80; }

  location / {
    proxy_pass http://shell:80;
  }
}
