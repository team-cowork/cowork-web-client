# DataGSM PKCE OAuth 연동 설정

# DataGSM에 등록된 클라이언트 ID (서버 전용, authorize 요청에 사용)
DATAGSM_CLIENT_ID=

# Cowork Authorization API(code/verifier 교환·토큰 갱신·로그아웃) 베이스 URL
# 예: https://auth.cowork.example.com/api
NEXT_PUBLIC_BASE_URL=

# 브라우저가 접근하는 공개 origin (OAuth redirect_uri 기준, 예: http://ssh.gsmsv.site:12345)
# 비워 두면 요청 URL 기준. standalone 컨테이너 배포 시에는 반드시 지정
APP_ORIGIN=

# 로컬에서 운영 API 호출 시 쿼리에 붙는 개발용 인증 값 (.env.local에만 설정, 운영 빌드에서는 무시됨)
NEXT_PUBLIC_DEV_CREDENTIAL=
