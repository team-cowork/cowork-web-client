# DataGSM 서버 관리 OAuth 연동 설정

# Cowork Authorization API(로그인 시작·완료·토큰 갱신·로그아웃) 베이스 URL
# 예: https://auth.cowork.example.com/api
NEXT_PUBLIC_BASE_URL=

# 브라우저가 접근하는 공개 origin (OAuth redirect_uri 기준, 예: http://ssh.gsmsv.site:12345)
# 비워 두면 요청 URL 기준. standalone 컨테이너 배포 시에는 반드시 지정
APP_ORIGIN=

# 로컬에서 운영 API 호출 시 쿼리에 붙는 개발용 인증 값 (.env.local에만 설정, 운영 빌드에서는 무시됨)
NEXT_PUBLIC_DEV_CREDENTIAL=

# 프로모션 개발 성과 페이지(/achievements)가 team-cowork 공개 저장소 통계를 모을 GitHub 읽기 토큰 (서버 전용)
# 비워 두면 저장소에 들어 있는 스냅샷(achievements-snapshot.json) 값을 보여 줍니다.
GITHUB_TOKEN=

# 회의록 AI 요약(/api/ai/summary)이 호출할 Groq API 키 (서버 전용). 비워 두면 AI 요약 기능이 꺼집니다.
GROQ_API_KEY=

# 요약에 쓸 Groq 모델. 비워 두면 openai/gpt-oss-120b
GROQ_MODEL=
