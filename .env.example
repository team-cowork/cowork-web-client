# compose.yaml 변수 치환에 쓰이는 값. 배포 VM 에서 `.env` 로 복사해 채운다.
# (compose 는 같은 디렉터리의 .env 를 자동 로드한다.)

# 배포할 이미지 태그 (CI 가 develop 으로 push)
IMAGE_TAG=develop

# nginx server_name. 도메인이 있으면 입력, 없으면 _ (모든 호스트)
SERVER_NAME=_

# shell 이 런타임에 로드할 MF remote 매니페스트 URL.
# 단일 오리진 경로 라우팅 기본값(상대경로). 서브도메인 분리 시 절대 URL 로 교체.
CHAT_REMOTE_URL=/_mf/chat/mf-manifest.json
ISSUE_REMOTE_URL=/_mf/issue/mf-manifest.json
PROFILE_REMOTE_URL=/_mf/profile/mf-manifest.json
